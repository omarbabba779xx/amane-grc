{
  "name": "amane-grc",
  "version": "0.2.0",
  "description": "Amane GRC : plateforme de conformité (ISO 27001, loi 09-08, DNSSI, NIST CSF, COBIT, EBIOS RM) pour les PME marocaines",
  "author": "Omar Babba",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.js",
    "screenshots": "node scripts/screenshots.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "10.0.15"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
